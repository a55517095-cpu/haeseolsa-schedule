# Supabase 프로젝트 설정 > API 에서 복사
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 로그인용 내부 이메일 도메인 (실제로 메일을 보내지 않는 가짜 도메인)
VITE_LOGIN_EMAIL_DOMAIN=guide.local

# PIN 4자리를 Supabase 최소 비밀번호 길이에 맞추기 위한 고정 문자열
# 한 번 정하면 절대 바꾸지 마세요. 바꾸면 기존 PIN으로 로그인이 안 됩니다.
VITE_PIN_PEPPER=jeju-guide-2026
